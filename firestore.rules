rules_version = '2';
// DRAFT - review against your data, then test in the Firebase Rules Playground
// before deploying. Derived from the reads/writes in client/src/api.js,
// Signup.jsx and Login.jsx.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return signedIn() && hasProfile() && me().get('active', true) != false; }
    function isAdmin() { return isActive() && me().get('role', 'student') == 'admin'; }
    // counselors must be approved by an admin before they get staff access
    function isStaff() {
      return isActive() && (me().get('role', 'student') == 'admin' || (me().get('role', 'student') == 'counselor' && me().get('approved', false) == true));
    }
    function touchesOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    // A check-in as the app writes it: only these fields, sane types and sizes, nothing pre-filled by the student,
    // and a risk level that is not lower than the score allows (high from 60% of the maximum, medium from 30%).
    // The rules cannot add up the answers or read the crisis item, so the safety flag is still taken on trust here;
    // the staff dashboard and the alert both re-check it.
    function validNewAssessment(d) {
      return d.keys().hasOnly(['studentId', 'studentName', 'studentEmail', 'answers', 'questionSummary', 'total',
                               'maxScore', 'riskLevel', 'flaggedForImmediateReview', 'status', 'counselorNotes', 'createdAt'])
        && d.studentName is string && d.studentName.size() <= 200
        && d.studentEmail is string && d.studentEmail.size() <= 200
        && d.createdAt is string
        && d.answers is list && d.answers.size() <= 20
        && d.questionSummary is list && d.questionSummary.size() <= 20
        && d.total is int && d.maxScore is int
        && d.maxScore > 0 && d.maxScore <= 60 && d.total >= 0 && d.total <= d.maxScore
        && d.riskLevel in ['low', 'medium', 'high']
        && d.flaggedForImmediateReview is bool
        && d.counselorNotes == ''
        && (d.total * 10 < d.maxScore * 6 || d.riskLevel == 'high')
        && (d.total * 10 < d.maxScore * 3 || d.riskLevel != 'low');
    }

    match /users/{uid} {
      // Staff need to read student profiles (names, emails, assignments).
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Self-signup always creates an active student profile - never a role.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.approved == true
        && request.resource.data.active == true
        // Only the fields sign-up writes, with sane sizes.
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'emailVerified', 'approved', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.emailVerified is bool;

      // Users edit only the settings fields the Settings page saves (an allowlist, so a new field is not writable by accident).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && touchesOnly(['name', 'phone', 'bio', 'avatarGradient', 'useGoogleAvatar', 'emergencyContact', 'wellnessGoals', 'updatedAt']))
        || isAdmin()
        || (isStaff() && touchesOnly(['assignedCounselorId', 'assignedCounselorName', 'assignedAt']))
      );
      allow delete: if false;
    }

    match /assessments/{id} {
      allow create: if isActive() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'open'
        && validNewAssessment(request.resource.data);
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      // Staff review a check-in: they can set the case status, the review time and their notes, nothing else.
      // The answers, score, risk level and owner stay exactly as the student submitted them.
      allow update: if isStaff()
        && touchesOnly(['status', 'reviewedAt', 'counselorNotes'])
        && request.resource.data.status in ['open', 'reviewed', 'escalated'];
      allow delete: if false;
    }

    match /appointments/{id} {
      // A booking always starts as a request; only staff can confirm it.
      allow create: if isActive() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Pending Review'
        // Only the fields the booking form writes, with sane sizes.
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'studentEmail', 'slotId', 'counselorId',
                                                 'counselorName', 'title', 'start', 'end', 'date', 'status', 'createdAt'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 200
        && request.resource.data.studentEmail is string && request.resource.data.studentEmail.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      // Staff change the status and the details the dashboard saves with it; the student, owner and booking details stay put.
      allow update: if (isStaff()
            && touchesOnly(['status', 'updatedAt', 'slotId', 'start', 'end', 'declineReason', 'cancellationReason',
                            'cancelledBy', 'rescheduleReason', 'counselorNote']))
        || (isActive() && resource.data.studentId == request.auth.uid
            && touchesOnly(['status', 'updatedAt', 'cancellationReason', 'cancelledBy'])
            && request.resource.data.status == 'Cancelled');
      allow delete: if false;
    }

    match /availability/{id} {
      allow read: if isActive();
      allow create: if isStaff() && request.resource.data.counselorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['counselorId', 'counselorName', 'start', 'end', 'isBooked', 'createdAt'])
        && request.resource.data.isBooked == false;
      // Students may only flip isBooked, and cannot book a slot that is already taken (no double booking).
      // They can still set it back to false, because they free their own slot when they cancel.
      allow update: if isStaff()
        || (isActive() && touchesOnly(['isBooked']) && request.resource.data.isBooked is bool
            && (request.resource.data.isBooked == false || resource.data.isBooked == false));
      allow delete: if isStaff() && resource.data.counselorId == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      allow create: if isActive() && request.resource.data.senderId == request.auth.uid
        && (request.resource.data.studentId == request.auth.uid || isStaff())
        // A student can only speak as a student; staff speak as staff (the app sends 'admin' for both roles).
        && (isStaff()
            ? request.resource.data.senderRole in ['admin', 'counselor']
            : request.resource.data.senderRole == 'student')
        // Same limits as the chat form: 1 to 2000 characters, and only the fields the app sends.
        && request.resource.data.keys().hasOnly(['studentId', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 200;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
