rules_version = '2';
// DRAFT - review against your data, then test in the Firebase Rules Playground
// before deploying. Derived from the reads/writes in client/src/api.js,
// Signup.jsx and Login.jsx.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActive() { return signedIn() && hasProfile() && me().get('active', true) != false; }
    function isAdmin() { return isActive() && me().get('role', 'student') == 'admin'; }
    // counselors must be approved by an admin before they get staff access
    function isStaff() {
      return isActive() && (me().get('role', 'student') == 'admin' || (me().get('role', 'student') == 'counselor' && me().get('approved', false) == true));
    }
    function touchesOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    // A case follow-up date is a calendar day ("2026-11-03") or empty to clear it; absent is fine.
    function validFollowUp(d) {
      return !('followUpDate' in d)
        || (d.followUpDate is string && d.followUpDate.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$'));
    }

    function shortText(v, max) { return v is string && v.size() <= max; }

    // A timestamp string as the app writes it (new Date().toISOString()) that is not more than a day ahead of the server
    // clock. A date far in the future would otherwise pin a record as the newest one. Only the future is bounded:
    // a write made offline and synced later legitimately carries an older time.
    function plausibleTime(s) {
      return s is string
        && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z')
        && timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('T')[0].split('-')[2]))
           <= request.time + duration.value(1, 'd');
    }

    // The questionSummary items are not checked one by one: the rules cannot loop, a rule may evaluate at most 1000
    // expressions, and checking 16 items by position (the full PHQ-9 + GAD-7 check-in) went over that limit in CI.
    // The list is capped at 20 items and the whole document at 1 MiB; the staff views show the text as plain text.

    // A check-in as the app writes it: only these fields, sane types and sizes, nothing pre-filled by the student,
    // and a risk level that is not lower than the score allows (high from 60% of the maximum, medium from 30%).
    // The rules cannot add up the answers or read the crisis item, so the safety flag is still taken on trust here;
    // the staff dashboard and the alert both re-check it.
    function validNewAssessment(d) {
      return d.keys().hasOnly(['studentId', 'studentName', 'studentEmail', 'answers', 'questionSummary', 'total',
                               'maxScore', 'riskLevel', 'flaggedForImmediateReview', 'status', 'counselorNotes', 'createdAt'])
        && d.studentName is string && d.studentName.size() <= 200
        && d.studentEmail is string && d.studentEmail.size() <= 200
        && plausibleTime(d.createdAt)
        && d.answers is list && d.answers.size() <= 20
        && d.answers.hasOnly([0, 1, 2, 3, null])
        && d.questionSummary is list && d.questionSummary.size() <= 20
        && d.total is int && d.maxScore is int
        && d.maxScore > 0 && d.maxScore <= 60 && d.total >= 0 && d.total <= d.maxScore
        && d.riskLevel in ['low', 'medium', 'high']
        && d.flaggedForImmediateReview is bool
        && d.counselorNotes == ''
        && (d.total * 10 < d.maxScore * 6 || d.riskLevel == 'high')
        && (d.total * 10 < d.maxScore * 3 || d.riskLevel != 'low');
    }

    // A WHO-5 wellbeing entry: only these fields, five whole-number answers from 0 to 5, and a score that is exactly
    // the answers added up and multiplied by 4 (0 to 100). It is informational and never changes a check-in's risk.
    function validNewWellbeing(d) {
      return d.keys().hasOnly(['studentId', 'answers', 'score', 'createdAt'])
        && plausibleTime(d.createdAt)
        && d.answers is list && d.answers.size() == 5
        && d.answers[0] is int && d.answers[0] >= 0 && d.answers[0] <= 5
        && d.answers[1] is int && d.answers[1] >= 0 && d.answers[1] <= 5
        && d.answers[2] is int && d.answers[2] >= 0 && d.answers[2] <= 5
        && d.answers[3] is int && d.answers[3] >= 0 && d.answers[3] <= 5
        && d.answers[4] is int && d.answers[4] >= 0 && d.answers[4] <= 5
        && d.score is int
        && d.score == (d.answers[0] + d.answers[1] + d.answers[2] + d.answers[3] + d.answers[4]) * 4;
    }

    function textOk(v, max) { return v is string && v.size() <= max; }
    function goalOk(g, i) { return g.size() <= i || textOk(g[i], 120); }
    // What the Settings page can save, with the same kinds of limits it applies: strings of sane length, a bool,
    // a small emergency-contact map and at most five goals. A field that is absent passes (the defaults are valid).
    function validProfileFields(d) {
      return textOk(d.get('name', ''), 200)
        && textOk(d.get('phone', ''), 40)
        && textOk(d.get('bio', ''), 1000)
        && textOk(d.get('avatarGradient', ''), 40)
        && textOk(d.get('updatedAt', ''), 40)
        && d.get('useGoogleAvatar', false) is bool
        && d.get('emergencyContact', {}) is map
        && d.get('emergencyContact', {}).keys().size() <= 10
        && textOk(d.get('emergencyContact', {}).get('name', ''), 200)
        && textOk(d.get('emergencyContact', {}).get('relationship', ''), 80)
        && textOk(d.get('emergencyContact', {}).get('phone', ''), 40)
        && textOk(d.get('emergencyContact', {}).get('alternatePhone', ''), 40)
        && textOk(d.get('emergencyContact', {}).get('notes', ''), 1000)
        && d.get('wellnessGoals', []) is list
        && d.get('wellnessGoals', []).size() <= 5
        && goalOk(d.get('wellnessGoals', []), 0) && goalOk(d.get('wellnessGoals', []), 1)
        && goalOk(d.get('wellnessGoals', []), 2) && goalOk(d.get('wellnessGoals', []), 3)
        && goalOk(d.get('wellnessGoals', []), 4);
    }

    match /users/{uid} {
      // Staff need to read student profiles (names, emails, assignments).
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Self-signup always creates an active student profile - never a role.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.approved == true
        && request.resource.data.active == true
        // Only the fields sign-up writes, with sane sizes.
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'emailVerified', 'approved', 'active', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.emailVerified is bool
        // New profiles need a school sign-in: the Auth token's email is an @usa.edu.ph address and the profile
        // carries that same email. This is not proof of ownership (password sign-up does not verify the address
        // before the profile is written), but it stops outside addresses from getting a profile at all.
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@usa[.]edu[.]ph')
        && request.resource.data.email.lower() == request.auth.token.email.lower();

      // Users edit only the settings fields the Settings page saves (an allowlist, so a new field is not writable by accident).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && touchesOnly(['name', 'phone', 'bio', 'avatarGradient', 'useGoogleAvatar', 'emergencyContact', 'wellnessGoals', 'updatedAt'])
          && validProfileFields(request.resource.data))
        || isAdmin()
        || (isStaff() && touchesOnly(['assignedCounselorId', 'assignedCounselorName', 'assignedAt']))
      );
      allow delete: if false;
    }

    match /assessments/{id} {
      allow create: if isActive() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'open'
        && validNewAssessment(request.resource.data);
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      // Staff review a check-in: they can set the case status, the review time, their notes and a follow-up date,
      // nothing else. The answers, score, risk level and owner stay exactly as the student submitted them.
      allow update: if isStaff()
        && touchesOnly(['status', 'reviewedAt', 'counselorNotes', 'followUpDate'])
        && request.resource.data.status in ['open', 'reviewed', 'escalated']
        && validFollowUp(request.resource.data);
      allow delete: if false;
    }

    match /wellbeing/{id} {
      allow create: if isActive() && request.resource.data.studentId == request.auth.uid
        && validNewWellbeing(request.resource.data);
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      allow update, delete: if false;
    }

    match /appointments/{id} {
      // A booking always starts as a request; only staff can confirm it.
      allow create: if isActive() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Pending Review'
        // Only the fields the booking form writes, with sane sizes.
        && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'studentEmail', 'slotId', 'counselorId',
                                                 'counselorName', 'title', 'start', 'end', 'date', 'status', 'createdAt'])
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 200
        && request.resource.data.studentEmail is string && request.resource.data.studentEmail.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        // Names and email are the student's own profile values (same idea as chat names), the booking time is a short
        // string, and createdAt is a real timestamp string.
        && (request.resource.data.studentName == me().get('name', '') || request.resource.data.studentName == 'Student')
        && (request.resource.data.studentEmail == me().get('email', '') || request.resource.data.studentEmail == request.auth.token.get('email', ''))
        && plausibleTime(request.resource.data.createdAt)
        && (!('start' in request.resource.data) || shortText(request.resource.data.start, 40))
        && (!('end' in request.resource.data) || shortText(request.resource.data.end, 40))
        && (!('date' in request.resource.data) || shortText(request.resource.data.date, 40))
        // A booking with a slot must claim that slot in the same batch (see the availability rule), so an
        // appointment cannot exist for a slot someone else holds.
        && (request.resource.data.slotId == null
            || getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.get('bookedAppointmentId', null) == id);
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      // Staff change the status and the details the dashboard saves with it; the student, owner and booking details stay put.
      allow update: if (isStaff()
            && touchesOnly(['status', 'updatedAt', 'slotId', 'start', 'end', 'declineReason', 'cancellationReason',
                            'cancelledBy', 'rescheduleReason', 'counselorNote']))
        || (isActive() && resource.data.studentId == request.auth.uid
            && touchesOnly(['status', 'updatedAt', 'cancellationReason', 'cancelledBy'])
            && request.resource.data.status == 'Cancelled');
      allow delete: if false;
    }

    match /availability/{id} {
      allow read: if isActive();
      allow create: if isStaff() && request.resource.data.counselorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['counselorId', 'counselorName', 'start', 'end', 'isBooked', 'createdAt'])
        && request.resource.data.isBooked == false
        && shortText(request.resource.data.start, 40) && shortText(request.resource.data.end, 40);
      // Students touch only isBooked/bookedBy/bookedAppointmentId, and only as part of a booking or a cancellation:
      //  - booking: the slot is free, and the same batch creates the student's appointment pointing at this slot;
      //  - release: the student who booked it frees it in a batch that also cancels their own appointment.
      //    Slots booked before these fields existed can only be freed by staff.
      allow update: if isStaff()
        || (isActive()
            && touchesOnly(['isBooked', 'bookedBy', 'bookedAppointmentId'])
            && request.resource.data.isBooked is bool
            && (
              (resource.data.isBooked == false
                && request.resource.data.isBooked == true
                && request.resource.data.get('bookedBy', null) == request.auth.uid
                && request.resource.data.get('bookedAppointmentId', null) is string
                && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.bookedAppointmentId)).data.studentId == request.auth.uid
                && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.bookedAppointmentId)).data.slotId == id
                && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.bookedAppointmentId)).data.status == 'Pending Review')
              ||
              (resource.data.isBooked == true
                && request.resource.data.isBooked == false
                && request.resource.data.get('bookedBy', null) == null
                && request.resource.data.get('bookedAppointmentId', null) == null
                && resource.data.get('bookedBy', null) == request.auth.uid
                && resource.data.get('bookedAppointmentId', null) is string
                && getAfter(/databases/$(database)/documents/appointments/$(resource.data.bookedAppointmentId)).data.studentId == request.auth.uid
                && getAfter(/databases/$(database)/documents/appointments/$(resource.data.bookedAppointmentId)).data.status == 'Cancelled')
            ));
      allow delete: if isStaff() && resource.data.counselorId == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if isActive() && (resource.data.studentId == request.auth.uid || isStaff());
      allow create: if isActive() && request.resource.data.senderId == request.auth.uid
        && (request.resource.data.studentId == request.auth.uid || isStaff())
        // A student can only speak as a student; staff speak as staff (the app sends 'admin' for both roles).
        && (isStaff()
            ? request.resource.data.senderRole in ['admin', 'counselor']
            : request.resource.data.senderRole == 'student')
        // Same limits as the chat form: 1 to 2000 characters, and only the fields the app sends.
        && request.resource.data.keys().hasOnly(['studentId', 'senderId', 'senderName', 'senderRole', 'text', 'timestamp'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 200
        // The name shown on a message is the sender's own profile name (or the app's generic fallback when it has none).
        && (request.resource.data.senderName == me().get('name', '')
            || request.resource.data.senderName in ['Student', 'Counselor', 'Staff Counselor']);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
